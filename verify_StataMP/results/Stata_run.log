> _results.dta, replace

. local COV c.age_c c.female c.educ_c c.apoe4

. 
. * fit: args = sample condition, rhs (factor-variable list), required vars, re
> ml|ml
. capture program drop fitm

. program define fitm
  1.     args cond rhs need method
  2.     capture drop _use _nuniq
  3.     gen _use = (`cond') & !missing(cdr, years, age_c, female, educ_c, apoe
> 4 `need')
  4.     bysort pid _use (years): gen _nuniq = sum(years != years[_n-1]) if _us
> e
  5.     bysort pid _use (_nuniq): replace _use = 0 if _nuniq[_N] < 2
  6.     quietly mixed cdr c.years##(`rhs' c.age_c c.female c.educ_c c.apoe4) i
> f _use || pid: years, cov(unstructured) `method' iterate(300)
  7. end

. capture program drop grab

. program define grab
  1.     args post key term
  2.     local b = _b[`term']
  3.     local s = _se[`term']
  4.     post `post' ("`key'") (`b') (`b' - invnormal(0.975)*`s') (`b' + invnor
> mal(0.975)*`s') (2*normal(-abs(`b'/`s'))) (el(e(N_g),1,1)) (e(N))
  5. end

